# Application
NODE_ENV=development
APP_URL=http://localhost:5173
API_PREFIX=/api/v1
PORT=8080

# MongoDB
MONGODB_URI=mongodb://localhost:27018/printing_erp

# Auth
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
BCRYPT_ROUNDS=12

# Public quotation / design links
PUBLIC_LINK_EXPIRES_DAYS=14

# Uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=25

# Logging
LOG_LEVEL=debug

# CORS
CORS_ORIGIN=http://localhost:5173

# Seed
SEED_OWNER_EMAIL=printfactorykoteshwara@gmail.com
SEED_OWNER_PASSWORD=Owner@12345
SEED_OWNER_NAME=Print Factory Owner

# Frontend (Vite)
VITE_API_URL=http://localhost:8080/api/v1
VITE_PUBLIC_URL=http://localhost:8080
